# Kairo production self-hosting environment template
# Copy to .env and update all values for your environment.

# Image tags
KAIRO_IMAGE_TAG=latest

# API/Worker runtime
KAIRO_ENVIRONMENT=Production
KAIRO_API_PORT=8080
KAIRO_SHUTDOWN_TIMEOUT_SECONDS=30

# PostgreSQL
KAIRO_POSTGRES_IMAGE=postgres:16-alpine
KAIRO_POSTGRES_PORT=5432
KAIRO_POSTGRES_DB=kairo
KAIRO_POSTGRES_USER=kairo
KAIRO_POSTGRES_PASSWORD=change_me

# NATS JetStream
KAIRO_NATS_IMAGE=nats:2.10-alpine
KAIRO_NATS_CLIENT_PORT=4222
KAIRO_NATS_MONITOR_PORT=8222
KAIRO_NATS_URL=nats://nats:4222
KAIRO_NATS_STREAM=KAIRO_EVENTS
KAIRO_NATS_SUBJECTS=event.>,delivery.>

# Required: base64 encoded 32-byte key for destination credential encryption.
# Example generation:
#   openssl rand -base64 32
KAIRO_DESTINATION_CREDENTIALS_KEY=replace_with_base64_32_byte_key

# Optional observability exporter endpoint
KAIRO_OTLP_ENDPOINT=
