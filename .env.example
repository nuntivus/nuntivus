# Nuntivus production self-hosting environment template
# Copy to .env and update all values for your environment.

# Image tags
NUNTIVUS_IMAGE_TAG=latest

# API/Worker runtime
NUNTIVUS_ENVIRONMENT=Production
NUNTIVUS_API_PORT=8080
NUNTIVUS_SHUTDOWN_TIMEOUT_SECONDS=30

# PostgreSQL
NUNTIVUS_POSTGRES_IMAGE=postgres:16-alpine
NUNTIVUS_POSTGRES_PORT=5432
NUNTIVUS_POSTGRES_DB=nuntivus
NUNTIVUS_POSTGRES_USER=nuntivus
NUNTIVUS_POSTGRES_PASSWORD=change_me
# Optional direct runtime mapping to Database:PostgresConnectionString
NUNTIVUS_DATABASE_CONNECTION_STRING=

# NATS JetStream
NUNTIVUS_NATS_IMAGE=nats:2.10-alpine
NUNTIVUS_NATS_CLIENT_PORT=4222
NUNTIVUS_NATS_MONITOR_PORT=8222
NUNTIVUS_NATS_URL=nats://nats:4222
NUNTIVUS_NATS_STREAM=NUNTIVUS_EVENTS
NUNTIVUS_NATS_SUBJECTS=event.>,delivery.>

# Required: base64 encoded 32-byte key for destination credential encryption.
# Example generation:
#   openssl rand -base64 32
NUNTIVUS_DESTINATION_CREDENTIALS_KEY=replace_with_base64_32_byte_key

# Optional observability exporter endpoint
NUNTIVUS_OTLP_ENDPOINT=
