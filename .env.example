# Nuntivus production self-hosting environment template
# Copy to .env and update all values for your environment.

# Local application build tag (not a registry image to pull)
NUNTIVUS_IMAGE_TAG=latest

# API/Worker runtime
NUNTIVUS_ENVIRONMENT=Production
NUNTIVUS_API_PORT=8080
NUNTIVUS_SHUTDOWN_TIMEOUT_SECONDS=30

# PostgreSQL
NUNTIVUS_POSTGRES_IMAGE=postgres:16-alpine
NUNTIVUS_POSTGRES_DB=nuntivus
NUNTIVUS_POSTGRES_USER=nuntivus
NUNTIVUS_POSTGRES_PASSWORD=

# NATS JetStream
NUNTIVUS_NATS_IMAGE=nats:2.10-alpine
NUNTIVUS_NATS_URL=nats://nats:4222
NUNTIVUS_NATS_STREAM=NUNTIVUS_EVENTS
NUNTIVUS_NATS_SUBJECTS=event.>,delivery.>

# Only for docker-compose.prod.yml + docker-compose.external.yml:
# Use the same database and destination encryption key on API and worker hosts.
# Set a private DNS name/IP reachable from containers, not localhost.
# NUNTIVUS_DATABASE_CONNECTION_STRING=Host=db.internal;Port=5432;Database=nuntivus;Username=nuntivus;Password=replace-me;SSL Mode=VerifyFull
# Replace the NUNTIVUS_NATS_URL above with the shared broker address.
# Optional broker authentication: token OR user/password, matching the NATS server.
NUNTIVUS_NATS_TOKEN=
NUNTIVUS_NATS_USER=
NUNTIVUS_NATS_PASSWORD=

# Required: base64 encoded 32-byte key for destination credential encryption.
# Example generation:
#   openssl rand -base64 32
NUNTIVUS_DESTINATION_CREDENTIALS_KEY=

# Admin authentication: generate a separate signing key with openssl rand -base64 32.
NUNTIVUS_LOCAL_AUTH_ENABLED=true
NUNTIVUS_LOCAL_AUTH_SIGNING_KEY=
# For an external identity provider, disable local auth and set both values.
NUNTIVUS_AUTHORITY=
NUNTIVUS_AUDIENCE=

# Trust only the actual reverse proxy IP as observed inside the API container.
# Do not use wildcard networks. The API host port binds to loopback only.
NUNTIVUS_PROXY_IP=127.0.0.1
NUNTIVUS_HTTPS_PORT=443

# Optional observability exporter endpoint
NUNTIVUS_OTLP_ENDPOINT=
