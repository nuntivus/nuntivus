<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageReference Include="Testcontainers" Version="3.10.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KairoServer.Api\KairoServer.Api.csproj" />
    <ProjectReference Include="..\KairoServer.Application\KairoServer.Application.csproj" />
    <ProjectReference Include="..\KairoServer.Common\KairoServer.Common.csproj" />
    <ProjectReference Include="..\KairoServer.Contracts\KairoServer.Contracts.csproj" />
    <ProjectReference Include="..\KairoServer.Domain\KairoServer.Domain.csproj" />
    <ProjectReference Include="..\KairoServer.Infastructure\KairoServer.Infastructure.csproj" />
    <ProjectReference Include="..\KairoServer.Worker\KairoServer.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\migration\003_create_customers.sql" Link="Migrations\003_create_customers.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\004_create_contracts.sql" Link="Migrations\004_create_contracts.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\001_create_events.sql" Link="Migrations\001_create_events.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\002_create_outbox_messages.sql" Link="Migrations\002_create_outbox_messages.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\005_create_deliveries.sql" Link="Migrations\005_create_deliveries.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\007_create_event_replays.sql" Link="Migrations\007_create_event_replays.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\008_create_event_definitions.sql" Link="Migrations\008_create_event_definitions.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\009_create_contract_filters.sql" Link="Migrations\009_create_contract_filters.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\010_add_contract_payload_transformations.sql" Link="Migrations\010_add_contract_payload_transformations.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\011_add_delivery_rate_limits.sql" Link="Migrations\011_add_delivery_rate_limits.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\012_add_delivery_ordering.sql" Link="Migrations\012_add_delivery_ordering.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\013_add_retention_cleanup_indexes.sql" Link="Migrations\013_add_retention_cleanup_indexes.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\014_add_outbox_retry_metadata.sql" Link="Migrations\014_add_outbox_retry_metadata.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\015_add_outbox_claim_indexes.sql" Link="Migrations\015_add_outbox_claim_indexes.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\016_add_delivery_contract_snapshots.sql" Link="Migrations\016_add_delivery_contract_snapshots.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\017_add_contract_snapshot_columns.sql" Link="Migrations\017_add_contract_snapshot_columns.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\018_add_delivery_scheduler_indexes.sql" Link="Migrations\018_add_delivery_scheduler_indexes.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\019_add_delivery_operation_audits.sql" Link="Migrations\019_add_delivery_operation_audits.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\020_create_delivery_replay_jobs.sql" Link="Migrations\020_create_delivery_replay_jobs.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\migration\021_create_audit_logs.sql" Link="Migrations\021_create_audit_logs.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Migrations\006_create_delivery_attempts.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyRootMigrations" AfterTargets="Build">
    <ItemGroup>
      <RootMigrationFiles Include="..\migration\001_create_events.sql;..\migration\002_create_outbox_messages.sql;..\migration\003_create_customers.sql;..\migration\004_create_contracts.sql;..\migration\005_create_deliveries.sql;..\migration\007_create_event_replays.sql;..\migration\008_create_event_definitions.sql;..\migration\009_create_contract_filters.sql;..\migration\010_add_contract_payload_transformations.sql;..\migration\011_add_delivery_rate_limits.sql;..\migration\012_add_delivery_ordering.sql;..\migration\013_add_retention_cleanup_indexes.sql;..\migration\014_add_outbox_retry_metadata.sql;..\migration\015_add_outbox_claim_indexes.sql;..\migration\016_add_delivery_contract_snapshots.sql;..\migration\017_add_contract_snapshot_columns.sql;..\migration\018_add_delivery_scheduler_indexes.sql;..\migration\019_add_delivery_operation_audits.sql;..\migration\020_create_delivery_replay_jobs.sql;..\migration\021_create_audit_logs.sql" />
    </ItemGroup>

    <MakeDir Directories="$(OutDir)Migrations" />
    <Copy
      SourceFiles="@(RootMigrationFiles)"
      DestinationFiles="@(RootMigrationFiles->'$(OutDir)Migrations\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
