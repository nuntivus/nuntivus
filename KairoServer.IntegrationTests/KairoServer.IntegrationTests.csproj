<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageReference Include="Testcontainers" Version="3.10.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KairoServer.Api\KairoServer.Api.csproj" />
    <ProjectReference Include="..\KairoServer.Application\KairoServer.Application.csproj" />
    <ProjectReference Include="..\KairoServer.Common\KairoServer.Common.csproj" />
    <ProjectReference Include="..\KairoServer.Contracts\KairoServer.Contracts.csproj" />
    <ProjectReference Include="..\KairoServer.Domain\KairoServer.Domain.csproj" />
    <ProjectReference Include="..\KairoServer.Infastructure\KairoServer.Infastructure.csproj" />
    <ProjectReference Include="..\KairoServer.Worker\KairoServer.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\003_create_customers.sql" Link="Migrations\003_create_customers.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\004_create_contracts.sql" Link="Migrations\004_create_contracts.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\001_create_events.sql" Link="Migrations\001_create_events.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\002_create_outbox_messages.sql" Link="Migrations\002_create_outbox_messages.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\005_create_deliveries.sql" Link="Migrations\005_create_deliveries.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\007_create_event_replays.sql" Link="Migrations\007_create_event_replays.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\008_create_event_definitions.sql" Link="Migrations\008_create_event_definitions.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\009_create_contract_filters.sql" Link="Migrations\009_create_contract_filters.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\010_add_contract_payload_transformations.sql" Link="Migrations\010_add_contract_payload_transformations.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\011_add_delivery_rate_limits.sql" Link="Migrations\011_add_delivery_rate_limits.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\012_add_delivery_ordering.sql" Link="Migrations\012_add_delivery_ordering.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="..\013_add_retention_cleanup_indexes.sql" Link="Migrations\013_add_retention_cleanup_indexes.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Migrations\006_create_delivery_attempts.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyRootMigrations" AfterTargets="Build">
    <ItemGroup>
      <RootMigrationFiles Include="..\001_create_events.sql;..\002_create_outbox_messages.sql;..\003_create_customers.sql;..\004_create_contracts.sql;..\005_create_deliveries.sql;..\007_create_event_replays.sql;..\008_create_event_definitions.sql;..\009_create_contract_filters.sql;..\010_add_contract_payload_transformations.sql;..\011_add_delivery_rate_limits.sql;..\012_add_delivery_ordering.sql;..\013_add_retention_cleanup_indexes.sql" />
    </ItemGroup>

    <MakeDir Directories="$(OutDir)Migrations" />
    <Copy
      SourceFiles="@(RootMigrationFiles)"
      DestinationFiles="@(RootMigrationFiles->'$(OutDir)Migrations\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
