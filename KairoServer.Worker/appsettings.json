{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=kairo;Username=postgres;Password=postgres"
  },
  "Database": {
    "PostgresConnectionString": "Host=localhost;Port=5433;Database=kairo;Username=postgres;Password=postgres"
  },
  "Worker": {
    "EnableOutboxPublisher": true,
    "EnableContractMatcher": true,
    "EnableDeliveryDispatcher": true,
    "EnableDeliveryRecovery": true,
    "EnableRetentionCleanup": true
  },
  "Outbox": {
    "BatchSize": 100,
    "PollDelay": "00:00:00.500",
    "EmptyPollDelay": "00:00:00.750",
    "MaxConcurrentPublishes": 8,
    "ClaimWorkerCount": 1,
    "ClaimTtl": "00:02:00",
    "FailureBackoffBaseDelay": "00:00:01",
    "FailureBackoffMaxDelay": "00:05:00",
    "FailureBackoffJitterRatio": 0.2
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "Name": "kairo-worker",
    "Stream": "KAIRO_EVENTS",
    "PublishAckTimeout": "00:00:05",
    "ConnectTimeout": "00:00:10"
  },
  "Matcher": {
    "WorkerName": "contract-matcher",
    "DurableName": "contract-matcher",
    "FilterSubject": "event.accepted",
    "BatchSize": 32,
    "MaxConcurrentMessages": 8,
    "FetchTimeout": "00:00:05",
    "NakDelay": "00:00:02",
    "MaxAckPending": 1000,
    "AckWait": "00:00:30",
    "MaxDeliver": 10
  },
  "Cache": {
    "Ttl": "00:01:00"
  },
  "Delivery": {
    "WorkerName": "delivery-dispatcher",
    "DurableName": "delivery-dispatcher",
    "FilterSubject": "delivery.ready",
    "BatchSize": 32,
    "MaxConcurrentMessages": 8,
    "FetchTimeout": "00:00:05",
    "NakDelay": "00:00:02",
    "MaxAckPending": 500,
    "AckWait": "00:02:00",
    "MaxDeliver": 10
  },
  "DeliveryRecovery": {
    "RunInterval": "00:00:30",
    "StaleInFlightAfter": "00:05:00",
    "BatchSize": 200
  },
  "DeliveryDispatcher": {
    "MaxAttempts": 5,
    "BaseBackoff": "00:00:01",
    "MaxBackoff": "00:05:00",
    "JitterRatio": 0.2
  },
  "DeliveryOrdering": {
    "LeaseDuration": "00:05:00"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "EndpointSecurity": {
    "AllowHttpScheme": false,
    "AllowPrivateNetworkDestinations": false,
    "AllowRedirects": false,
    "MaxResponseBodyBytes": 1024
  },
  "DestinationCredentials": {
    "EncryptionKey": ""
  },
  "RetentionCleanup": {
    "Enabled": true,
    "RunInterval": "00:05:00",
    "BatchSize": 500,
    "MaxBatchesPerCycle": 20,
    "InterBatchDelay": "00:00:00.100",
    "EventRetention": "30.00:00:00",
    "DeliveryRetention": "14.00:00:00",
    "DeliveryAttemptRetention": "14.00:00:00",
    "ProcessedOutboxRetention": "7.00:00:00"
  }
}
