{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=kairo;Username=postgres;Password=postgres"
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "Name": "kairo-worker",
    "Stream": "KAIRO_EVENTS",
    "PublishAckTimeout": "00:00:05",
    "ConnectTimeout": "00:00:10"
  },
  "Matcher": {
    "DurableName": "contract-matcher",
    "FilterSubject": "event.accepted",
    "BatchSize": 32,
    "FetchTimeout": "00:00:05",
    "NakDelay": "00:00:02",
    "MaxAckPending": 1000
  },
  "Cache": {
    "Ttl": "00:01:00"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RetentionCleanup": {
    "Enabled": true,
    "RunInterval": "00:05:00",
    "BatchSize": 500,
    "MaxBatchesPerCycle": 20,
    "InterBatchDelay": "00:00:00.100",
    "EventRetention": "30.00:00:00",
    "DeliveryRetention": "14.00:00:00",
    "DeliveryAttemptRetention": "14.00:00:00",
    "ProcessedOutboxRetention": "7.00:00:00"
  }
}
