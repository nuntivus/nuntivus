{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "PostgresConnectionString": ""
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "ApiSecurity": {
    "MaxRequestBodyBytes": 1048576,
    "MaxEventPayloadBytes": 262144,
    "MaxEventMetadataBytes": 65536
  },
  "LocalAuth": {
    "Enabled": false,
    "Issuer": "nuntivus.local",
    "Audience": "nuntivus.dashboard",
    "SigningKey": "",
    "AccessTokenLifetime": "00:30:00",
    "ClockSkew": "00:01:00"
  },
  "Cache": {
    "Ttl": "00:01:00"
  },
  "EndpointSecurity": {
    "AllowHttpScheme": false,
    "AllowPrivateNetworkDestinations": false,
    "AllowRedirects": false,
    "MaxResponseBodyBytes": 1024,
    "MaxHeaders": 64,
    "MaxConfigurationBytes": 65536
  },
  "DestinationCredentials": {
    "EncryptionKey": ""
  }
}
