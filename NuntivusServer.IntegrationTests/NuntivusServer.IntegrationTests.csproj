<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.Kafka" Version="4.16.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageReference Include="Testcontainers" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuntivusServer.Api\NuntivusServer.Api.csproj" />
    <ProjectReference Include="..\NuntivusServer.Application\NuntivusServer.Application.csproj" />
    <ProjectReference Include="..\NuntivusServer.Common\NuntivusServer.Common.csproj" />
    <ProjectReference Include="..\NuntivusServer.Contracts\NuntivusServer.Contracts.csproj" />
    <ProjectReference Include="..\NuntivusServer.Domain\NuntivusServer.Domain.csproj" />
    <ProjectReference Include="..\NuntivusServer.Infastructure\NuntivusServer.Infastructure.csproj" />
    <ProjectReference Include="..\NuntivusServer.Worker\NuntivusServer.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\migration\*.sql" Link="Migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
