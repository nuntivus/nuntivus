{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start website",
      "type": "shell",
      "command": "npm start -- --no-open",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "docusaurus",
        "pattern": {
          "regexp": "^(.*):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting the development server",
          "endsPattern": "compiled successfully"
        }
      }
    }
  ]
}
