{
  "name": "nuntivus-website",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": { "node": ">=24 <25" },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "tinypool": "^2.2.0"
  },
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "prestart": "npm run sync-docs",
    "start": "docusaurus start --port 5180",
    "prebuild": "npm run sync-docs",
    "build": "docusaurus build",
    "postbuild": "node scripts/check-seo.mjs",
    "serve": "docusaurus serve --port 5180",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "~5.9.3"
  }
